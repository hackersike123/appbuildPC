PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=3600

# Gmail SMTP for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-gmail-app-password
APP_BASE_URL=https://your-forwarded-url

# All app AI tasks use this LM Studio model with PCBUILD-specific prompts.
LM_STUDIO_URL=http://127.0.0.1:3106/v1
LM_STUDIO_MODEL=replace-with-loaded-lm-studio-model-id
LM_STUDIO_VISION_MODEL=replace-with-loaded-vision-model-id
# Optional bearer token, if LM Studio authentication is enabled:
# LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT_MS=240000

# SQL Server persistence used by the current relational API
MSSQL_REQUIRED=true
MSSQL_SERVER=hackersike123.ddns.net
MSSQL_PORT=46494
MSSQL_DATABASE=PCBuildLocal
MSSQL_USER=tuan_dev
MSSQL_PASSWORD=replace-with-sql-password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT=10000
MSSQL_REQUEST_TIMEOUT=10000
