{
  "openapi": "3.0.3",
  "info": {
    "title": "PCBUILD LOCAL API",
    "version": "1.0.0",
    "description": "JWT protected API for PC configurations."
  },
  "servers": [{ "url": "/" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "minLength": 8 }
        }
      },
      "Build": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "budget": { "type": "integer" },
          "areaId": { "type": "string" },
          "components": { "type": "object" },
          "version": { "type": "integer", "minimum": 1 },
          "syncState": { "type": "string", "enum": ["synced", "stale", "conflict"] },
          "totalPrice": { "type": "integer" },
          "completion": { "type": "integer" },
          "estimatedPower": { "type": "integer" },
          "recommendedPsu": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": { "summary": "Health check", "responses": { "200": { "description": "API is running" } } }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Create an account",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } } },
        "responses": { "201": { "description": "Created" }, "409": { "description": "Email exists" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login and receive a JWT",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } } },
        "responses": { "200": { "description": "JWT returned" }, "401": { "description": "Invalid credentials" } }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "summary": "Send a one-time password reset email",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } } } } },
        "responses": { "202": { "description": "Request accepted" }, "422": { "description": "Invalid email" }, "503": { "description": "SMTP unavailable" } }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "summary": "Set a new password using a one-time token",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["token", "password"], "properties": { "token": { "type": "string" }, "password": { "type": "string", "format": "password", "minLength": 8 } } } } } },
        "responses": { "200": { "description": "Password updated" }, "400": { "description": "Invalid or expired token" }, "422": { "description": "Invalid request" } }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Current user",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "User profile" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/api/v1/builds": {
      "get": {
        "summary": "List the current user's builds",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Build list" } }
      },
      "post": {
        "summary": "Create a build",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Build" } } } },
        "responses": { "201": { "description": "Build created" } }
      }
    },
    "/api/v1/builds/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "summary": "Get one build",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Build" }, "404": { "description": "Not found" } }
      },
      "put": {
        "summary": "Update build metadata",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Build" } } } },
        "responses": { "200": { "description": "Updated build" }, "404": { "description": "Not found" } }
      },
      "delete": {
        "summary": "Delete one build",
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } }
      }
    },
    "/api/v1/builds/{id}/components/{type}": {
      "put": {
        "summary": "Add or replace a component",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "type", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["productId"], "properties": { "productId": { "type": "string", "nullable": true, "description": "Product ID to add/replace; null removes this component." }, "expectedVersion": { "type": "integer" } } } } } },
        "responses": { "200": { "description": "Updated build" }, "409": { "description": "Version conflict" } }
      }
    },
    "/api/v1/builds/{id}/duplicate": {
      "post": {
        "summary": "Duplicate a saved build",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "201": { "description": "Duplicated build" }, "404": { "description": "Not found" } }
      }
    },
    "/api/v1/compare": {
      "get": {
        "summary": "Compare two or three catalog products",
        "parameters": [{ "name": "productIds", "in": "query", "required": true, "schema": { "type": "string", "description": "Comma-separated product IDs" } }],
        "responses": { "200": { "description": "Comparison result" }, "422": { "description": "Invalid product count" } }
      }
    },
    "/api/v1/products": {
      "get": {
        "summary": "List SQL catalog products at the selected area's price",
        "parameters": [
          { "name": "type", "in": "query", "schema": { "type": "string" } },
          { "name": "areaId", "in": "query", "schema": { "type": "string", "default": "hcm" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Products and area prices from SQL" } }
      }
    },
    "/api/v1/market/summary": {
      "get": {
        "summary": "Get current area prices and record a SQL history snapshot",
        "parameters": [{ "name": "areaId", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Market summary" } }
      }
    },
    "/api/v1/prices": {
      "get": {
        "summary": "Get current price and daily, monthly, or yearly SQL history",
        "parameters": [
          { "name": "productId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "areaId", "in": "query", "schema": { "type": "string" } },
          { "name": "period", "in": "query", "schema": { "type": "string", "enum": ["day", "month", "year"] } }
        ],
        "responses": { "200": { "description": "Current price, previous price, change, and SQL history points" } }
      }
    },
    "/api/v1/compatibility/check": {
      "post": {
        "summary": "Check compatibility for two or more selected SQL catalog components",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["components"], "properties": { "areaId": { "type": "string" }, "components": { "type": "object", "additionalProperties": { "type": "string" } } } } } } },
        "responses": { "200": { "description": "Compatibility report" }, "422": { "description": "Fewer than two valid components" } }
      }
    },
    "/api/v1/ai/chat": {
      "post": {
        "summary": "Ask the local PC assistant using SQL catalog context",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["messages"], "properties": { "messages": { "type": "array", "items": { "type": "object" } } } } } } },
        "responses": { "200": { "description": "Local model response" }, "502": { "description": "Local model unavailable" } }
      }
    },
    "/api/v1/ai/scan": {
      "post": {
        "summary": "Analyze a product image with LM Studio and archive the result in SQL",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["imageBase64", "imageMimeType"], "properties": { "imageBase64": { "type": "string" }, "imageMimeType": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Scan result saved in SQL" }, "422": { "description": "Invalid image" }, "502": { "description": "LM Studio vision model unavailable" } }
      }
    },
    "/api/v1/ai/generate-build": {
      "post": {
        "summary": "Generate a build from SQL first, using LM Studio when needed",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["budget", "purpose"], "properties": { "budget": { "type": "integer" }, "purpose": { "type": "string" }, "areaId": { "type": "string" }, "pinnedComponents": { "type": "object", "additionalProperties": { "type": "string" } } } } } } },
        "responses": { "200": { "description": "SQL or LM Studio fallback build" }, "422": { "description": "No valid build in budget" }, "502": { "description": "LM Studio fallback failed" } }
      }
    },
    "/api/v1/scans": {
      "get": {
        "summary": "List the current user's SQL scan history",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Scan history" } }
      }
    },
    "/api/v1/scans/{id}": {
      "get": {
        "summary": "Get a scan record and its archived image",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Scan details" }, "404": { "description": "Not found" } }
      },
      "delete": {
        "summary": "Delete the current user's SQL scan and archived image",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Scan deleted" }, "404": { "description": "Not found" } }
      }
    },
    "/api/v1/price-alerts": {
      "get": { "summary": "List the current user's price alerts", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Price alerts" } } },
      "post": {
        "summary": "Create a SQL-backed price alert",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["productId", "targetPrice"], "properties": { "productId": { "type": "string" }, "targetPrice": { "type": "integer" }, "areaId": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Alert created" }, "422": { "description": "Invalid alert" } }
      }
    },
    "/api/v1/price-alerts/{id}": {
      "put": {
        "summary": "Edit a SQL-backed price alert",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["productId", "targetPrice", "areaId"], "properties": { "productId": { "type": "string" }, "targetPrice": { "type": "integer" }, "areaId": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Alert updated" }, "404": { "description": "Not found" } }
      },
      "delete": {
        "summary": "Delete a SQL-backed price alert",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Alert deleted" }, "404": { "description": "Not found" } }
      }
    },
    "/api/v1/scans/{id}/confirm": {
      "post": {
        "summary": "Confirm an AI scan candidate",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["productId"], "properties": { "productId": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Confirmed scan" }, "422": { "description": "Candidate is invalid" } }
      }
    },
    "/api/v1/faq": {
      "get": {
        "summary": "Search frequently asked questions",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "FAQ entries" } }
      }
    },
    "/api/v1/support-requests": {
      "post": {
        "summary": "Create a support request",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Support request received" }, "422": { "description": "Invalid request" } }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "List notifications",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Notifications" } }
      }
    }
  }
}
